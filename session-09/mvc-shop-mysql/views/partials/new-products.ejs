<section class="product-section">
    <h2>New Products</h2>
    <div class="product-list">
        <% if (products.length === 0) { %>
            <p>No new products found.</p>
        <% } %>
        <% products.forEach(product => { %>
            <%- include("product-card", { product }) %>
        <% }) %>
    </div>
</section>