<%- include('layout/header') %>

<div class="container" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="mb-0 fw-bold"><i class="bi bi-plus-square me-2 text-primary"></i>Add new product</h4>
        </div>
        <div class="card-body p-4">
            <form action="/add" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Product name</label>
                    <input type="text" name="name" class="form-control" placeholder="Ví dụ: iPhone 15 Pro Max" required>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Price ($)</label>
                        <input type="number" step="0.01" name="price" class="form-control" placeholder="0.00" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Quantity in stock</label>
                        <input type="number" name="quantity" class="form-control" placeholder="10" required>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Product photo</label>
                    <input type="file" name="image" class="form-control" accept="image/*" required>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="/" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i> Save the product</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('layout/footer') %>