<%- include('layout/header') %>

<div class="container py-3">
    <div class="card shadow-sm border-0 overflow-hidden mx-auto" style="max-width: 800px;">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-3">
                <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>" style="max-height: 320px; object-fit: contain;">
            </div>
            <div class="col-md-7 d-flex flex-column">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h3 class="card-title fw-bold mb-0"><%= product.name %></h3>
                        <span class="badge <%= product.quantity > 0 ? 'bg-success' : 'bg-danger' %> fs-6">
                            <%= product.quantity > 0 ? 'Still in stock' : 'Out of stock' %>
                        </span>
                    </div>
                    <p class="text-danger fw-bold display-6 mb-3">$<%= product.price.toLocaleString() %></p>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Quantity in stock:</span>
                            <strong><%= product.quantity %></strong>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Product ID:</span>
                            <code class="text-secondary"><%= product._id %></code>
                        </li>
                    </ul>
                    <div class="d-flex gap-2">
                        <a href="/edit/<%= product._id %>" class="btn btn-warning text-white"><i class="bi bi-pencil me-1"></i> Edit</a>
                        <form action="/delete/<%= product._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Do you want to delete');">
                            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                        </form>
                        <a href="/" class="btn btn-light ms-auto"><i class="bi bi-arrow-left me-1"></i> Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>