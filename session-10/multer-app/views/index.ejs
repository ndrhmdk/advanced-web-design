<%- include('layout/header') %>

<div class="container">
    <div class="row align-items-center mb-4">
        <div class="col-md-6 mb-2 mb-md-0">
            <h2 class="fw-bold mb-0">Product List</h2>
            <p class="text-muted mb-0">Total: <%= products.length %> products</p>
        </div>
        <div class="col-md-6">
            <form action="/" method="GET" class="d-flex gap-2">
                <div class="input-group">
                    <input type="text" name="q" class="form-control" placeholder="Search with product name..." value="<%= searchQuery %>">
                    <button class="btn btn-dark" type="submit"><i class="bi bi-search"></i> Search</button>
                </div>
                <% if (searchQuery) { %>
                    <a href="/" class="btn btn-outline-secondary">Back</a>
                <% } %>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <% if (products.length === 0) { %>
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="mt-2 text-muted">Cannot find any product.</p>
            <a href="/add" class="btn btn-outline-primary">Create the first product.</a>
        </div>
        <% } %>

        <% products.forEach(product => { %>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 card-product shadow-sm border-0">
                <div class="card-img-wrap position-relative">
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                    <span class="badge <%= product.quantity > 0 ? 'bg-success' : 'bg-danger' %> position-absolute top-0 end-0 m-2">
                        <%= product.quantity > 0 ? 'Quantity in stock: ' + product.quantity : 'Out of stock' %>
                    </span>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate" title="<%= product.name %>"><%= product.name %></h5>
                    <p class="card-text text-danger fw-bold fs-5 mb-3">$<%= product.price.toLocaleString() %></p>

                    <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                        <a href="/products/<%= product._id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Details</a>
                        <div class="btn-group">
                            <a href="/edit/<%= product._id %>" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <form action="/delete/<%= product._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<%- include('layout/footer') %>