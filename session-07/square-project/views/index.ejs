<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculate Square Properties</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-slate-100 px-4 py-12 text-slate-800">
    <main class="mx-auto max-w-md">
        <section class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <div class="mb-8 text-center">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-indigo-100">
                    <div class="h-7 w-7 rounded border-2 border-indigo-600"></div>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Square Calculator</h1>
                <p class="mt-2 text-sm text-slate-500">Enter a side length to calculate its perimeter and area.</p>
            </div>

            <form action="/calculate" method="POST" class="space-y-5">
                <div>
                    <label for="sideLength" class="mb-2 block text-sm font-medium text-slate-700">Side length</label>
                    <input
                        type="number"
                        id="sideLength"
                        name="sideLength"
                        min="0"
                        step="any"
                        placeholder="e.g. 5"
                        required
                        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
                    >
                </div>
                <button type="submit" class="w-full rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-200">
                    Calculate
                </button>
            </form>

            <% if (perimeter !== null && area !== null) { %>
                <div class="mt-7 grid grid-cols-2 gap-3 border-t border-slate-200 pt-7">
                    <div class="rounded-xl bg-slate-50 p-4 text-center">
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Perimeter</p>
                        <p class="mt-1 text-2xl font-bold text-indigo-600"><%= perimeter %></p>
                    </div>
                    <div class="rounded-xl bg-slate-50 p-4 text-center">
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Area</p>
                        <p class="mt-1 text-2xl font-bold text-indigo-600"><%= area %></p>
                    </div>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>

