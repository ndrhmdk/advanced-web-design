<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Celeb List</title>
</head>
<body>
    <h1>List of Celebrities</h1>
    <ul>
        <% celebs.forEach(p => { %>
            <li><a href="/celebs/<%= p.id %>"> <%= p.name %> - $<%= p.netWorth %></a></li>
        <% }) %>
    </ul>
</body>
</html>
