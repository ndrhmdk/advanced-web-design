<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách sản phẩm</title>
</head>
<body>
    <h1>Danh sách sản phẩm</h1>
    <ul>
        <% products.forEach(p => { %>
            <li><a href="/products/<%= p.id %>"><%= p.name %> - $<%= p.price %></a></li>
        <% }); %>
    </ul>
</body>
</html>
